---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Steady Hand</title>
    <meta name="description" content="A tiny steady-hand browser game." />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <main>
      <h1>Steady Hand</h1>
      <div id="hud">
        <span id="level-label">Level 1 of 3</span>
        <span id="timer">0.0s</span>
      </div>
      <svg id="board" viewBox="0 0 100 60" preserveAspectRatio="xMidYMid meet">
        <rect id="hit-area" x="0" y="0" width="100" height="60" fill="transparent" />
        <polyline id="track" fill="none" />
        <circle id="end-dot" r="3" />
        <circle id="bead" />
      </svg>
      <p id="status" aria-live="polite" class="visually-hidden"></p>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
