---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Steady Hand</title>
    <meta name="description" content="A tiny steady-hand browser game." />
    <meta name="theme-color" content="#0a0e1f" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%2338bdf8'/%3E%3Cstop offset='1' stop-color='%23c084fc'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='8' fill='%230a0e1f'/%3E%3Cpath d='M6 22 L12 8 L18 24 L26 8' stroke='url(%23g)' stroke-width='3.2' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <div class="bg-fx" aria-hidden="true"></div>
    <header>
      <nav aria-label="Primary">
        <a class="brand" href="./">
          <span class="brand-mark" aria-hidden="true"></span>
          Steady Hand
        </a>
      </nav>
    </header>
    <main>
      <div class="game-shell">
        <h1>Steady Hand</h1>

        <div id="hud">
          <div class="hud-chip hud-chip--level">
            <span class="hud-chip-label">Level</span>
            <span id="level-label">Level 1 of 3</span>
            <span class="level-dots" aria-hidden="true">
              <span class="level-dot"></span>
              <span class="level-dot"></span>
              <span class="level-dot"></span>
            </span>
          </div>
          <div class="hud-chip hud-chip--timer">
            <span class="hud-chip-label">Time</span>
            <span id="timer">0.0s</span>
          </div>
        </div>

        <div class="board-frame">
          <svg id="board" viewBox="0 0 100 60" preserveAspectRatio="xMidYMid meet">
            <defs>
              <pattern id="grid" width="6" height="6" patternUnits="userSpaceOnUse">
                <circle cx="1" cy="1" r="0.35" fill="rgba(148,163,184,0.16)" />
              </pattern>
              <linearGradient id="trackGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#7dd3fc" />
                <stop offset="50%" stop-color="#818cf8" />
                <stop offset="100%" stop-color="#c084fc" />
              </linearGradient>
              <radialGradient id="beadGradient" cx="35%" cy="30%" r="75%">
                <stop offset="0%" stop-color="#f0f9ff" />
                <stop offset="45%" stop-color="#38bdf8" />
                <stop offset="100%" stop-color="#0369a1" />
              </radialGradient>
              <radialGradient id="boardVignette" cx="50%" cy="45%" r="75%">
                <stop offset="0%" stop-color="#131c34" />
                <stop offset="100%" stop-color="#060913" />
              </radialGradient>
            </defs>
            <rect class="board-bg" x="0" y="0" width="100" height="60" fill="url(#boardVignette)" />
            <rect class="board-grid" x="0" y="0" width="100" height="60" fill="url(#grid)" />
            <rect id="hit-area" x="0" y="0" width="100" height="60" fill="transparent" />
            <use href="#track" class="track-glow" aria-hidden="true"></use>
            <polyline id="track" fill="none" />
            <use href="#end-dot" class="end-ring end-ring--outer" aria-hidden="true"></use>
            <use href="#end-dot" class="end-ring end-ring--inner" aria-hidden="true"></use>
            <circle id="end-dot" r="3" />
            <use href="#bead" class="bead-glow" aria-hidden="true"></use>
            <circle id="bead" />
          </svg>
        </div>

        <p id="status" aria-live="polite"></p>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
